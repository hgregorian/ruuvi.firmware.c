+
+#define POSTMORTEM_CMD_REPORT "DIAG?"
+#define POSTMORTEM_CMD_CRASH  "CRASH"
+#define POSTMORTEM_CMD_CLEAR  "CLEAR"
+#define POSTMORTEM_CMD_LEN     (5U)
+
+static uint16_t postmortem_filename_hash (const char * filename)
+{
+    uint16_t hash = 0x811CU;
+
+    if (NULL == filename)
+    {
+        return 0U;
+    }
+
+    while ('\0' != *filename)
+    {
+        hash ^= (uint8_t) *filename;
+        hash = (uint16_t) (hash * 0x0193U);
+        filename++;
+    }
+
+    return hash;
+}
+
+/*
+ * PM v1 packet, exactly 20 bytes:
+ *
+ *   50 4D 01 RR RR RR RR EE EE EE EE LL LL HH HH VV SS SS SS SS
+ *   P  M v1 <RESETREAS LE> <fatal error LE> <line LE> <file hash LE>
+ *            <valid> <flash-load status LE>
+ *
+ * valid=1 means a persistent fatal record was recovered. RESETREAS is read
+ * directly and is never cleared or modified by this diagnostic.
+ */
+static void postmortem_report_send (const ri_comm_xfer_fp_t reply_fp)
+{
+    rt_flash_fatal_record_t record = {0};
+    const rd_status_t load_status = rt_flash_fatal_load (&record);
+    const bool valid = (RD_SUCCESS == load_status)
+                       && (RT_FLASH_FATAL_MAGIC == record.magic);
+
+    ri_comm_message_t msg = {0};
+    msg.data_length = 20U;
+    msg.repeat_count = 1U;
+    msg.data[0] = 0x50U; /* P */
+    msg.data[1] = 0x4DU; /* M */
+    msg.data[2] = 0x01U; /* version */
+
+    const uint32_t resetreas = NRF_POWER->RESETREAS;
+    msg.data[3] = (uint8_t) ((resetreas >> 0U) & 0xFFU);
+    msg.data[4] = (uint8_t) ((resetreas >> 8U) & 0xFFU);
+    msg.data[5] = (uint8_t) ((resetreas >> 16U) & 0xFFU);
+    msg.data[6] = (uint8_t) ((resetreas >> 24U) & 0xFFU);
+
+    const rd_status_t fatal_error = valid ? record.error : RD_SUCCESS;
+    msg.data[7] = (uint8_t) ((fatal_error >> 0U) & 0xFFU);
+    msg.data[8] = (uint8_t) ((fatal_error >> 8U) & 0xFFU);
+    msg.data[9] = (uint8_t) ((fatal_error >> 16U) & 0xFFU);
+    msg.data[10] = (uint8_t) ((fatal_error >> 24U) & 0xFFU);
+
+    const uint16_t line = valid ? (uint16_t) record.line : 0U;
+    msg.data[11] = (uint8_t) ((line >> 0U) & 0xFFU);
+    msg.data[12] = (uint8_t) ((line >> 8U) & 0xFFU);
+
+    const uint16_t file_hash = valid ? postmortem_filename_hash (record.filename) : 0U;
+    msg.data[13] = (uint8_t) ((file_hash >> 0U) & 0xFFU);
+    msg.data[14] = (uint8_t) ((file_hash >> 8U) & 0xFFU);
+
+    msg.data[15] = valid ? 1U : 0U;
+    msg.data[16] = (uint8_t) ((load_status >> 0U) & 0xFFU);
+    msg.data[17] = (uint8_t) ((load_status >> 8U) & 0xFFU);
+    msg.data[18] = (uint8_t) ((load_status >> 16U) & 0xFFU);
+    msg.data[19] = (uint8_t) ((load_status >> 24U) & 0xFFU);
+
+    (void) reply_fp (&msg);
+}
+
+static bool postmortem_command_handle (const ri_comm_xfer_fp_t reply_fp,
+                                       const uint8_t * const data,
+                                       const size_t data_len)
+{
+    if ((NULL == data) || (POSTMORTEM_CMD_LEN != data_len))
+    {
+        return false;
+    }
+
+    if (0 == memcmp (data, POSTMORTEM_CMD_REPORT, POSTMORTEM_CMD_LEN))
+    {
+        postmortem_report_send (reply_fp);
+        return true;
+    }
+
+    if (0 == memcmp (data, POSTMORTEM_CMD_CLEAR, POSTMORTEM_CMD_LEN))
+    {
+        (void) rt_flash_fatal_clear_sync();
+        return true;
+    }
+
+    if (0 == memcmp (data, POSTMORTEM_CMD_CRASH, POSTMORTEM_CMD_LEN))
+    {
+        /*
+         * Intentional validation of the exact production fatal path:
+         * rd_error_check() -> app_on_error() -> persistent fatal store ->
+         * ri_power_reset().
+         */
+        RD_ERROR_CHECK (RD_ERROR_INVALID_STATE, RD_SUCCESS);
+        return true;
+    }
+
+    return false;
+}
