+static uint16_t postmortem_filename_hash_raw (const char * filename)
+{
+    uint16_t hash = 0x811CU;
+    if (NULL == filename)
+    {
+        return 0U;
+    }
+    const char * base = filename;
+    for (const char * p = filename; '\0' != *p; p++)
+    {
+        if (('/' == *p) || ('\\' == *p))
+        {
+            base = p + 1;
+        }
+    }
+    for (const char * p = base; '\0' != *p; p++)
+    {
+        hash ^= (uint8_t) *p;
+        hash = (uint16_t) (hash * 0x0193U);
+    }
+    return hash;
+}
+
+static uint32_t postmortem_journal_checksum (const rt_flash_postmortem_journal_record_t * const p_record)
+{
+    uint32_t hash = 2166136261UL;
+    const uint8_t * p = (const uint8_t *) p_record;
+    const size_t n = offsetof (rt_flash_postmortem_journal_record_t, checksum);
+    for (size_t i = 0U; i < n; i++)
+    {
+        hash ^= p[i];
+        hash *= 16777619UL;
+    }
+    return hash;
+}
+
+#ifndef CEEDLING
+static bool postmortem_raw_slot_erased (const volatile uint32_t * const p_slot)
+{
+    for (size_t i = 0U; i < (sizeof (rt_flash_postmortem_journal_record_t) / sizeof (uint32_t)); i++)
+    {
+        if (0xFFFFFFFFUL != p_slot[i])
+        {
+            return false;
+        }
+    }
+    return true;
+}
+
+static bool postmortem_raw_record_valid (const rt_flash_postmortem_journal_record_t * const p_record)
+{
+    return (RT_FLASH_POSTMORTEM_JOURNAL_MAGIC == p_record->magic)
+           && (postmortem_journal_checksum (p_record) == p_record->checksum);
+}
