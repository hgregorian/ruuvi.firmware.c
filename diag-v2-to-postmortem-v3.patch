+        jmsg.data[15] = (uint8_t) ((jr_line >> 8U) & 0xFFU);
+        jmsg.data[16] = (uint8_t) ((jr.file_hash >> 0U) & 0xFFU);
+        jmsg.data[17] = (uint8_t) ((jr.file_hash >> 8U) & 0xFFU);
+        jmsg.data[18] = 0U;
