+static rd_status_t postmortem_journal_append (const rt_reset_source_t source,
+                                               const bool fatal_valid,
+                                               const rd_status_t error,
+                                               const char * const file,
+                                               const int line)
+{
+    const size_t slots = RT_FLASH_POSTMORTEM_RAW_PAGE_SIZE / sizeof (rt_flash_postmortem_journal_record_t);
+    volatile uint32_t * const p_page = (volatile uint32_t *) RT_FLASH_POSTMORTEM_RAW_ADDR;
+    size_t slot = slots;
+    for (size_t i = 0U; i < slots; i++)
+    {
+        volatile uint32_t * const p_slot = p_page + (i * (sizeof (rt_flash_postmortem_journal_record_t) / sizeof (uint32_t)));
+        if (postmortem_raw_slot_erased (p_slot))
+        {
+            slot = i;
+            break;
+        }
+    }
+    if (slots == slot)
+    {
+        return RD_ERROR_NO_MEM;
+    }
+
+    rt_flash_postmortem_journal_record_t record;
+    memset (&record, 0, sizeof (record));
+    record.magic = RT_FLASH_POSTMORTEM_JOURNAL_MAGIC;
+    record.sequence = (uint32_t) slot + 1U;
+    record.reset_source = (uint8_t) source;
+    record.fatal_valid = fatal_valid ? 1U : 0U;
+    record.file_hash = fatal_valid ? postmortem_filename_hash_raw (file) : 0U;
+    record.error = fatal_valid ? error : RD_SUCCESS;
+    record.line = fatal_valid ? line : 0;
+    record.checksum = postmortem_journal_checksum (&record);
+
+    volatile uint32_t * const p_dst = p_page + (slot * (sizeof (record) / sizeof (uint32_t)));
+    return postmortem_raw_write_words_sync (p_dst, (const uint32_t *) &record, sizeof (record) / sizeof (uint32_t));
+}
