+        jmsg.data[7] = (uint8_t) ((jr.sequence >> 8U) & 0xFFU);
+        jmsg.data[8] = (uint8_t) ((jr.sequence >> 16U) & 0xFFU);
+        jmsg.data[9] = (uint8_t) ((jr.sequence >> 24U) & 0xFFU);
+        jmsg.data[10] = (uint8_t) ((jr.error >> 0U) & 0xFFU);
