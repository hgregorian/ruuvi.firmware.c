+static rd_status_t postmortem_raw_write_words_sync (volatile uint32_t * const p_dst,
+                                                     const uint32_t * const p_src,
+                                                     const size_t words)
+{
+    if (nrf_sdh_is_enabled())
+    {
+        ret_code_t rc = NRF_ERROR_BUSY;
+        uint32_t elapsed_ms = 0U;
+        while ((NRF_SUCCESS != rc) && (elapsed_ms < RT_FLASH_POSTMORTEM_RAW_WRITE_WAIT_MS))
+        {
+            rc = sd_flash_write ((uint32_t *) p_dst, p_src, (uint32_t) words);
+            if (NRF_SUCCESS == rc)
+            {
+                break;
+            }
+            if ((NRF_ERROR_BUSY != rc) && (NRF_ERROR_RESOURCES != rc))
+            {
+                return ruuvi_nrf5_sdk15_to_ruuvi_error (rc);
+            }
+            ri_delay_us (1000U);
+            elapsed_ms++;
+        }
+        if (NRF_SUCCESS != rc)
+        {
+            return RD_ERROR_TIMEOUT;
+        }
+    }
+    else
+    {
+        nrf_nvmc_write_words ((uint32_t *) p_dst, p_src, words);
+    }
+
+    for (uint32_t elapsed_ms = 0U; elapsed_ms < RT_FLASH_POSTMORTEM_RAW_WRITE_WAIT_MS; elapsed_ms++)
+    {
+        bool match = true;
+        for (size_t i = 0U; i < words; i++)
+        {
+            if (p_dst[i] != p_src[i])
+            {
+                match = false;
+                break;
+            }
+        }
+        if (match)
+        {
+            return RD_SUCCESS;
+        }
+        ri_delay_us (1000U);
+    }
+    return RD_ERROR_TIMEOUT;
+}
